# Servidor
NODE_ENV=production
PORT=3000
PUBLIC_API_URL=https://finny-bot.onrender.com
ALLOWED_ORIGINS=https://allofinancas.com,https://www.allofinancas.com
LOG_LEVEL=info

# Firebase Admin (conta de serviço do projeto Firebase)
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"SEU_PROJETO_FIREBASE"}

# Google Play Developer API (conta de serviço convidada no Play Console)
GOOGLE_PLAY_CREDENTIALS=
GOOGLE_PLAY_PACKAGE_NAME=com.allofinancas
GOOGLE_PLAY_PRODUCT_MONTHLY=allofy_pro_monthly
GOOGLE_PLAY_PRODUCT_YEARLY=allofy_pro_yearly
# Janela para vincular uma compra NOVA/pendente ao UID autenticado quando houver histórico legado divergente
GOOGLE_PLAY_FRESH_PURCHASE_WINDOW_MINUTES=30

# Real-time Developer Notifications — deixe em branco até configurar o Pub/Sub push autenticado
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT=

# IA Allofy V44 — Free + Pro com controle de custo
OPENAI_API_KEY=
# Pro: modelo principal de alta capacidade
OPENAI_AGENT_MODEL=gpt-5.6
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=max
# Free: modelo econômico e ainda operacional
OPENAI_FREE_AGENT_MODEL=gpt-5.6-luna
OPENAI_FREE_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=90000
# Push-to-talk: Pro usa transcrição completa; Free usa mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_FREE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIBE_TIMEOUT_MS=60000
# Modo ao vivo Pro
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_CONNECT_TIMEOUT_MS=30000

# Franquias mensais Allofy
ALLOFY_FREE_COMMANDS_MONTHLY=20
ALLOFY_FREE_VOICE_COMMANDS_MONTHLY=5
ALLOFY_PRO_COMMANDS_MONTHLY=150
ALLOFY_PRO_VOICE_COMMANDS_MONTHLY=150
ALLOFY_PRO_LIVE_MINUTES_MONTHLY=25
ALLOFY_LIVE_SESSION_MAX_MINUTES=10
# Proteção anti-spam por minuto (não substitui as franquias mensais)
ALLOFY_MINUTE_LIMIT=30
AI_DAILY_LIMIT=120
AI_MINUTE_LIMIT=30

# Push e rotinas internas
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
